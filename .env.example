# =============================================================================
# ClearStrata — 前端环境变量（Vite 仅暴露以 VITE_ 开头的变量到浏览器）
# =============================================================================
#
# 本地开发：复制本文件为 .env 后填写真实值
#   copy .env.example .env   （Windows PowerShell 可用 Copy-Item）
#
# Vercel：Project → Settings → Environment Variables
#   - 对 Production / Preview / Development 按需勾选后保存
#   - 重新 Deploy 一次使变量生效
#
# 切勿将 .env 提交到 Git（已在 .gitignore 中忽略）
# =============================================================================

# Supabase 项目 URL（Dashboard → Project Settings → API → Project URL）
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase 匿名（公开）密钥（同上页面 → anon public key）
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# 服务端（Vercel Serverless /api/*）— 不要加 VITE_ 前缀，切勿暴露到浏览器
# ---------------------------------------------------------------------------
# 与 VITE_SUPABASE_URL 相同即可（也可用 SUPABASE_URL）
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Dashboard → Project Settings → API → service_role（仅服务器）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 本地调试 /api/*：在项目根目录运行 npx vercel dev（会同时拉起 Serverless 与前端）
